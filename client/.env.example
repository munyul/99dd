# ─────────────────────────────────────────────
# 1) .env.development  — 공개 설정 (커밋 O)
#    OCR 서버 URL 등 팀원과 공유해도 되는 값
# ─────────────────────────────────────────────
VITE_OCR_API_URL=http://localhost:8000

# ─────────────────────────────────────────────
# 2) .env.local  — 비밀키 (커밋 X, gitignore)
#    본인 PC에만 client/.env.local 파일을 만들고 아래 값을 채우세요
# ─────────────────────────────────────────────
# VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here
